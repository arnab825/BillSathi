# ==========================================
# BillSathi Configuration
# Tagline: Financial documents you can verify, not just extract.
# ==========================================

# Database
DATABASE_URL=sqlite:///./data/billsathi.db

# Ollama Local AI Runtime
# Default for native execution: http://localhost:11434
# Default for Podman/Docker containers: http://host.containers.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=45.0

# Server & Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
